<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_nexo_pos" model="ir.ui.view">
        <field name="name">product.template.form.nexo_pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="nexo_pos_linked" string="En NexoPOS" readonly="1" invisible="not barcode"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_nexo_pos" model="ir.ui.view">
        <field name="name">product.template.search.nexo_pos</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter name="nexo_pos_linked" string="En NexoPOS" domain="[('nexo_pos_linked', '=', True)]"/>
                <filter name="nexo_pos_missing" string="No está en NexoPOS"
                        domain="[('nexo_pos_linked', '=', False), ('barcode', '!=', False), ('sale_ok', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
