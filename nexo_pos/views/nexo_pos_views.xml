<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nexo_pos_stock_diff_view_list" model="ir.ui.view">
        <field name="name">nexo.pos.stock.diff.list</field>
        <field name="model">nexo.pos.stock.diff</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button name="action_compare_now" type="object" string="Comparar ahora" display="always"
                            groups="stock.group_stock_manager"/>
                    <button name="action_use_odoo" type="object" string="Dejar NexoPOS como Odoo"
                            groups="stock.group_stock_manager"
                            confirm="Se le manda a NexoPOS la diferencia como ajuste. Es una escritura en el stock real del comercio. ¿Seguimos?"/>
                    <button name="action_use_nexopos" type="object" string="Dejar Odoo como NexoPOS"
                            groups="stock.group_stock_manager"
                            confirm="Se hace un ajuste de inventario en Odoo con el número de NexoPOS. ¿Seguimos?"/>
                </header>
                <field name="product_id"/>
                <field name="barcode" optional="show"/>
                <field name="stock_odoo"/>
                <field name="stock_nexopos"/>
                <field name="pendiente" optional="show"/>
                <field name="sin_respuesta" optional="show" decoration-warning="sin_respuesta != 0"/>
                <field name="diferencia" decoration-danger="diferencia &lt; 0" decoration-info="diferencia &gt; 0"/>
                <field name="uom_id" optional="hide"/>
                <field name="compared_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="nexo_pos_stock_diff_action" model="ir.actions.act_window">
        <field name="name">Diferencias de stock con NexoPOS</field>
        <field name="res_model">nexo.pos.stock.diff</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Odoo y NexoPOS dicen lo mismo</p>
            <p>Se compara una vez por día, o con «Comparar ahora». Una diferencia negativa suele ser un
               pedido de NexoTienda aceptado en NexoPOS que Odoo todavía no registró.</p>
        </field>
    </record>

    <record id="nexo_pos_stock_queue_view_list" model="ir.ui.view">
        <field name="name">nexo.pos.stock.queue.list</field>
        <field name="model">nexo.pos.stock.queue</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="state == 'uncertain'" decoration-danger="state == 'error'"
                  decoration-muted="state == 'sent'">
                <header>
                    <button name="action_retry" type="object" string="Reintentar" groups="stock.group_stock_manager"
                            confirm="Reintentá solo si revisaste en NexoPOS que el ajuste no llegó: si llegó, se suma dos veces."/>
                    <button name="action_discard" type="object" string="Descartar" groups="stock.group_stock_manager"/>
                </header>
                <field name="create_date" string="Fecha"/>
                <field name="product_id"/>
                <field name="cantidad"/>
                <field name="move_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="sent_at" optional="hide"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="nexo_pos_stock_queue_view_search" model="ir.ui.view">
        <field name="name">nexo.pos.stock.queue.search</field>
        <field name="model">nexo.pos.stock.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <filter name="open" string="Para revisar" domain="[('state', '!=', 'sent')]"/>
                <filter name="uncertain" string="Sin respuesta" domain="[('state', '=', 'uncertain')]"/>
                <filter name="error" string="Rechazados" domain="[('state', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="nexo_pos_stock_queue_action" model="ir.actions.act_window">
        <field name="name">Ajustes de stock a NexoPOS</field>
        <field name="res_model">nexo.pos.stock.queue</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay ajustes pendientes</p>
            <p>Cada movimiento del depósito que comparte stock con NexoPOS se manda como ajuste, cada minuto.</p>
        </field>
    </record>

    <record id="action_nexo_pos_create_products" model="ir.actions.server">
        <field name="name">Dar de alta en NexoPOS</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['nexo.pos.service']._action_create_from_templates(records)</field>
    </record>
</odoo>
