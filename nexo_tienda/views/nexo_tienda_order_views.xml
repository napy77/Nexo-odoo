<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nexo_tienda_order_view_list" model="ir.ui.view">
        <field name="name">nexo.tienda.order.list</field>
        <field name="model">nexo.tienda.order</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('entregado', 'cancelado')" decoration-danger="error" create="0">
                <header>
                    <button name="action_sync_now" type="object" string="Traer pedidos ahora" display="always"
                            class="btn-secondary"/>
                </header>
                <field name="code"/>
                <field name="creado"/>
                <field name="contacto_nombre"/>
                <field name="tipo"/>
                <field name="franja"/>
                <field name="pago_texto" string="Pago"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total" sum="Total"/>
                <field name="sale_order_id" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'recibido'"
                       decoration-warning="state in ('aceptado', 'listo', 'en_camino')"
                       decoration-success="state == 'entregado'"/>
                <field name="entregar_pendiente" optional="hide"/>
                <field name="error" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="nexo_tienda_order_view_form" model="ir.ui.view">
        <field name="name">nexo.tienda.order.form</field>
        <field name="model">nexo.tienda.order</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_accept" type="object" string="Aceptar" class="btn-primary"
                            invisible="state != 'recibido'"/>
                    <button name="action_ready" type="object" string="Listo" class="btn-primary"
                            invisible="state != 'aceptado'"/>
                    <button name="action_on_the_way" type="object" string="Salió" class="btn-primary"
                            invisible="state != 'listo' or tipo != 'reparto'"/>
                    <button name="action_deliver" type="object" string="Entregado" class="btn-primary"
                            invisible="state not in ('listo', 'en_camino')"
                            confirm="Se le avisa a NexoPOS que se entregó, y la entrega de Odoo se valida. Si lo cobrás en la caja no hace falta: se avisa solo. ¿Seguimos?"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('entregado', 'cancelado')"/>
                    <button name="action_refresh" type="object" string="Actualizar" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="recibido,aceptado,listo,entregado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_order" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Pedido de venta"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not revision_texto">
                        <field name="revision_texto" readonly="1"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not no_cobrar or state in ('entregado', 'cancelado')">
                        <strong>No lo cobres en la caja: </strong><field name="pago_texto" readonly="1" class="d-inline"/>.
                        Al entregarlo, tocá «Entregado».
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not error">
                        <field name="error" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="code"/></h1>
                    </div>
                    <group>
                        <group string="Comprador">
                            <field name="contacto_nombre"/>
                            <field name="contacto_telefono" widget="phone"/>
                            <field name="cuenta_id" invisible="not cuenta_id"/>
                            <field name="partner_id" invisible="not partner_id"/>
                            <field name="notas" invisible="not notas"/>
                        </group>
                        <group string="Entrega">
                            <field name="creado"/>
                            <field name="tipo"/>
                            <field name="franja"/>
                            <field name="direccion" invisible="not direccion"/>
                            <field name="listo_para" invisible="not listo_para"/>
                            <field name="pago_texto" string="Pago"/>
                            <field name="no_cobrar" invisible="1"/>
                            <field name="motivo_cancelacion" invisible="state != 'cancelado'"/>
                            <field name="cancelado_por" invisible="state != 'cancelado'"/>
                            <field name="venta_ticket" invisible="not venta_ticket"/>
                            <field name="entregar_pendiente" invisible="not entregar_pendiente"/>
                            <field name="pos_order_id" invisible="not pos_order_id"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="nombre"/>
                            <field name="ean" optional="show"/>
                            <field name="producto_id" optional="hide"/>
                            <field name="product_id"/>
                            <field name="cantidad"/>
                            <field name="unidad"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="precio"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="currency_id" invisible="1"/>
                        <field name="subtotal"/>
                        <field name="cargo" invisible="not cargo"/>
                        <field name="total" class="oe_subtotal_footer_separator"/>
                    </group>
                    <field name="company_id" invisible="1"/>
                    <field name="tipo" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexo_tienda_order_view_search" model="ir.ui.view">
        <field name="name">nexo.tienda.order.search</field>
        <field name="model">nexo.tienda.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="contacto_nombre"/>
                <field name="contacto_telefono"/>
                <filter name="en_curso" string="En curso" domain="[('state', 'in', ('recibido', 'aceptado', 'listo', 'en_camino'))]"/>
                <filter name="recibidos" string="Para aceptar" domain="[('state', '=', 'recibido')]"/>
                <filter name="con_problema" string="Con problema" domain="['|', ('error', '!=', False), ('entregar_pendiente', '=', True)]"/>
                <separator/>
                <filter name="por_estado" string="Estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="nexo_tienda_order_action" model="ir.actions.act_window">
        <field name="name">Pedidos de NexoTienda</field>
        <field name="res_model">nexo.tienda.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_en_curso': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No hay pedidos de NexoTienda en curso</p>
            <p>Entran solos cada minuto, si están prendidos en Ajustes → NexoPOS. Se cobran en el Punto de Venta con «Cobrar un pedido».</p>
        </field>
    </record>
</odoo>
