<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nexo_tienda_step_view_form" model="ir.ui.view">
        <field name="name">nexo.tienda.step.form</field>
        <field name="model">nexo.tienda.step</field>
        <field name="arch" type="xml">
            <form>
                <field name="order_id" invisible="1"/>
                <field name="step" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="step != 'aceptar' or not revision_texto">
                    <field name="revision_texto" readonly="1"/>
                </div>
                <group>
                    <field name="listo_para" invisible="step != 'aceptar'" required="step == 'aceptar'"/>
                    <field name="motivo" invisible="step != 'cancelar'" required="step == 'cancelar'"
                           placeholder="«No me queda de ananá, tengo de muzzarella; pasá igual y te la hago»"/>
                </group>
                <p class="text-muted" invisible="step != 'aceptar'">
                    Al aceptarlo, NexoPOS descuenta el stock y le avisa al comprador.
                </p>
                <p class="text-muted" invisible="step != 'cancelar'">
                    NexoPOS devuelve el stock, le avisa al comprador y, si pagó con Mercado Pago, le devuelve la plata.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Aceptar pedido" class="btn-primary"
                            invisible="step != 'aceptar'"/>
                    <button name="action_confirm" type="object" string="Cancelar pedido" class="btn-danger"
                            invisible="step != 'cancelar'"/>
                    <button string="Volver" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
