<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El QR en papel, para cuando la pantalla no da hacia el cliente. Dice
         hasta qué hora sirve: un QR impreso parece que vale para siempre y
         éste vence a los 3 minutos. -->
    <record id="action_report_clubpay_qr" model="ir.actions.report">
        <field name="name">QR de ClubPay</field>
        <field name="model">nexo.clubpay.charge</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nexo_clubpay.report_clubpay_qr</field>
        <field name="print_report_name">'QR ClubPay %s' % object.name</field>
    </record>

    <template id="report_clubpay_qr">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="charge">
                <t t-call="web.basic_layout">
                    <div class="page text-center" style="font-size: 16px;">
                        <h2 t-out="charge.company_id.name"/>
                        <t t-if="charge.sale_order_id"><div>Pedido <span t-out="charge.sale_order_id.name"/></div></t>
                        <h3 class="mt-3">Usá tu descuento de ClubPay</h3>
                        <div>Escaneá este código con la app de ClubPay</div>
                        <img t-att-src="charge._qr_image(400)" style="width: 70mm; height: 70mm; margin: 6mm auto; display: block;"/>
                        <div class="fs-3 fw-bold">Total <span t-field="charge.ticket_total"/></div>
                        <div class="fw-bold mt-2" t-if="charge.expires_at">
                            Vence a las <span t-out="charge.expires_at" t-options="{'widget': 'datetime', 'format': 'HH:mm'}"/>
                        </div>
                        <div t-if="charge.simulated" class="fw-bold mt-3">SIMULADOR · NO SIRVE CON LA APP</div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
