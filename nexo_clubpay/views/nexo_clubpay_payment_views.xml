<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nexo_clubpay_payment_list" model="ir.ui.view">
        <field name="name">nexo.clubpay.payment.list</field>
        <field name="model">nexo.clubpay.payment</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'paid'" decoration-muted="state in ('cancelled', 'expired')"
                  decoration-danger="state == 'paid' and not has_sale">
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="origin"/>
                <field name="channel"/>
                <field name="amount" sum="Total"/>
                <field name="refunded" optional="show"/>
                <field name="fee" optional="hide"/>
                <field name="state"/>
                <field name="has_sale"/>
                <field name="simulated" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="nexo_clubpay_payment_form" model="ir.ui.view">
        <field name="name">nexo.clubpay.payment.form</field>
        <field name="model">nexo.clubpay.payment</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_refresh" type="object" string="Consultar a ClubPay"/>
                    <button name="action_refund" type="object" string="Devolver" groups="base.group_system"
                            invisible="to_refund &lt;= 0"
                            confirm="Se le devuelve al cliente lo que falta devolver, por Mercado Pago. No se puede deshacer. ¿Seguimos?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,paid"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" invisible="not simulated">Simulador: no se cobró nada.</div>
                    <div class="alert alert-danger" invisible="state != 'paid' or has_sale">
                        El cliente pagó y el pago no quedó en ninguna venta. Si no corresponde, devolvelo.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="origin"/>
                            <field name="channel"/>
                            <field name="external_reference"/>
                            <field name="pos_payment_id" invisible="not pos_payment_id"/>
                            <field name="transaction_id" invisible="not transaction_id"/>
                            <field name="sale_order_id" invisible="not sale_order_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="fee"/>
                            <field name="refunded"/>
                            <field name="to_refund" invisible="to_refund &lt;= 0"/>
                            <field name="paid_at"/>
                            <field name="mp_payment_id"/>
                            <field name="expires_at"/>
                            <field name="error" invisible="not error"/>
                            <field name="has_sale" invisible="1"/>
                            <field name="simulated" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="nexo_clubpay_payment_search" model="ir.ui.view">
        <field name="name">nexo.clubpay.payment.search</field>
        <field name="model">nexo.clubpay.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="mp_payment_id"/>
                <filter name="paid" string="Pagados" domain="[('state', 'in', ('paid', 'refunded'))]"/>
                <filter name="pending" string="Esperando" domain="[('state', '=', 'pending')]"/>
                <separator/>
                <filter name="pos" string="Punto de Venta" domain="[('origin', '=', 'pos')]"/>
                <filter name="sale" string="Ventas" domain="[('origin', '=', 'sale')]"/>
            </search>
        </field>
    </record>

    <record id="nexo_clubpay_payment_action" model="ir.actions.act_window">
        <field name="name">Cobros con Mercado Pago</field>
        <field name="res_model">nexo.clubpay.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_paid': 1}</field>
    </record>

    <menuitem id="menu_nexo_clubpay_payment_sale" name="Cobros con Mercado Pago" parent="sale.sale_order_menu"
              action="nexo_clubpay_payment_action" sequence="91"/>
    <menuitem id="menu_nexo_clubpay_payment_pos" name="Cobros con Mercado Pago" parent="point_of_sale.menu_point_of_sale"
              action="nexo_clubpay_payment_action" sequence="91"/>

    <record id="ir_cron_nexo_clubpay_payment_check" model="ir.cron">
        <field name="name">ClubPay: releer cobros con Mercado Pago</field>
        <field name="model_id" ref="model_nexo_clubpay_payment"/>
        <field name="state">code</field>
        <field name="code">env['nexo.clubpay.payment']._cron_check()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
