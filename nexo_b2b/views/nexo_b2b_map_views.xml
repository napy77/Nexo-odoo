<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nexo_b2b_tax_map_view_list" model="ir.ui.view">
        <field name="name">nexo.b2b.tax.map.list</field>
        <field name="model">nexo.b2b.tax.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="company_id" column_invisible="True"/>
                <field name="alicuota"/>
                <field name="sale_tax_id" context="{'default_type_tax_use': 'sale'}"/>
                <field name="purchase_tax_id" context="{'default_type_tax_use': 'purchase'}"/>
                <field name="without_tax"/>
                <field name="confirmed" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="nexo_b2b_tax_map_action" model="ir.actions.act_window">
        <field name="name">Alícuotas de NexoB2B</field>
        <field name="res_model">nexo.b2b.tax.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Cada alícuota de IVA de NexoB2B se asocia a un impuesto de venta y uno de compra de Odoo.
               Las propuestas sin confirmar se vuelven a preguntar al agregar un producto.</p>
        </field>
    </record>

    <record id="nexo_b2b_category_map_view_list" model="ir.ui.view">
        <field name="name">nexo.b2b.category.map.list</field>
        <field name="model">nexo.b2b.category.map</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="pasillo" readonly="1"/>
                <field name="rubro" readonly="1"/>
                <field name="subrubro" readonly="1"/>
                <field name="nexo_level" readonly="1" optional="hide"/>
                <field name="nexo_key" readonly="1" optional="hide"/>
                <field name="categ_id"/>
            </list>
        </field>
    </record>

    <record id="nexo_b2b_category_map_action" model="ir.actions.act_window">
        <field name="name">Categorías de NexoB2B</field>
        <field name="res_model">nexo.b2b.category.map</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Se completa sola: la primera vez que agregás un producto de una categoría de NexoB2B
               se pregunta dónde ubicarlo, y queda guardado acá.</p>
        </field>
    </record>
</odoo>
